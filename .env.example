# Web3Forms access key for the contact form (https://web3forms.com — free tier).
# Local: copy this file to .env.local and paste your key.
# Prod: Vercel → Project → Settings → Environment Variables.
VITE_WEB3FORMS_ACCESS_KEY=

# GitHub personal access token for api/github.js (fine-grained, public repos
# read-only — no scopes needed). Server-side only: never exposed to the browser.
GITHUB_TOKEN=
